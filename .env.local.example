# Copy this file to .env.local (same folder) and fill in real values as
# you get them. .env.local is kept out of git by the .gitignore in this
# project root — this .example file is the only one meant to be checked
# into version control.
#
# Organized by build step. Steps 1–3 are built (see README.md for setup);
# steps 4–5 aren't yet.


# ── Step 1: Real map + location search ──────────────────────────────
# Powers the map + Places Autocomplete that will replace the map
# placeholder in page.tsx.
# Get a key at https://console.cloud.google.com — enable both the Maps
# JavaScript API and the Places API on the project.
# Prefixed NEXT_PUBLIC_ because the map renders in the browser, so this
# key is necessarily visible to anyone using the app — once you have a
# domain, restrict it there (Google Cloud Console > Credentials).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ── Step 2: AI-search backend ────────────────────────────────────────
# Powers the two TODOs already stubbed in app/api/plan/route.ts: AI
# candidate search, then verification against Google Places.

# Get a key at https://console.anthropic.com
# Server-only: never prefix this with NEXT_PUBLIC_, or it becomes
# visible in the browser.
ANTHROPIC_API_KEY=

# Can reuse the same Google Cloud project as the Maps key above, but
# this is its own server-only key — don't reuse the NEXT_PUBLIC_ one.
GOOGLE_PLACES_API_KEY=


# ── Step 3: Real accounts (replacing localStorage) ───────────────────
# Using Supabase. Get both values from your project's dashboard at
# https://supabase.com/dashboard > Settings > API.

# The "Project URL" — safe to expose in the browser, hence NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon public" key (shown as "publishable key" on newer projects).
# Also safe to expose in the browser — it respects Supabase's Row Level
# Security rules, so it can't do anything you haven't explicitly allowed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key (Settings > API). SERVER-ONLY and SECRET — it
# bypasses Row Level Security. Used only for the shared search cache
# (plan_cache table). Never prefix with NEXT_PUBLIC_. Optional: without it
# search results are cached per server instance only.
SUPABASE_SERVICE_ROLE_KEY=


# ── Step 4: Stripe ────────────────────────────────────────────────────
# Powers real payment method collection on the Account page. Test keys
# work immediately, no approval wait — get them at
# https://dashboard.stripe.com/test/apikeys

# Server-only: never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Safe to expose in the browser — Stripe's publishable keys are
# designed to be public, that's why this one IS prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# ── Affiliate booking links ────────────────────────────────────────────
# Your Booking.com Affiliate Partner ID (the "aid", from the Affiliate
# Partner Centre once approved). Safe to expose — it's in every link.
# With it set, stay links earn commission and the booking sheet shows a
# short affiliate disclosure. Without it, stay links still open
# Booking.com with dates filled in, just untracked.
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=

# Other affiliate programmes (app/lib/affiliates.ts). Each venue card in
# the plan sheets gets a small "Book on OpenTable" / "Tickets on
# Ticketmaster" / "Tickets on GetYourGuide" / "Book on JustPark" link
# once that programme's IDs are set; nothing shows until then.
# Awin (awin.com) — your publisher ID, then each advertiser's ID ("mid",
# shown on its programme page once you're approved):
NEXT_PUBLIC_AWIN_PUBLISHER_ID=
NEXT_PUBLIC_AWIN_MID_OPENTABLE=
NEXT_PUBLIC_AWIN_MID_TICKETMASTER=
NEXT_PUBLIC_AWIN_MID_JUSTPARK=
# GetYourGuide Partner Portal (partner.getyourguide.com) — your partner ID:
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=


# ── Step 5: Partner booking APIs ──────────────────────────────────────
# Not listed yet — each partner (Booking.com, Expedia, OpenTable,
# TheFork, DesignMyNight, JustPark) hands you different credentials
# once their partner/affiliate application is approved, and the shape
# varies per provider (API key, OAuth client, sandbox vs. live, etc).
# Add a section here per partner as each one comes through.
